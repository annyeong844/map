{
  "name": "@annyeong844/code-map",
  "version": "0.9.0-rc.1",
  "description": "A code map that routes to coordinates, not meaning. Guides an LLM to the crate; the LLM interprets the raw from there.",
  "type": "module",
  "homepage": "https://github.com/annyeong844/map#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/annyeong844/map.git"
  },
  "bugs": {
    "url": "https://github.com/annyeong844/map/issues"
  },
  "files": [
    "dist",
    "src/py/extract.py",
    "skills",
    "hooks",
    ".claude-plugin",
    ".grok-plugin",
    ".agents",
    "plugins",
    "GEMINI.md",
    "scripts/check-package-safety.mjs",
    "scripts/check-versions.mjs",
    "scripts/package-smoke.mjs",
    "scripts/build.mjs",
    "scripts/prepare-package.mjs",
    "scripts/benchmark.mjs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "bin": {
    "map": "dist/cli/main.js",
    "map-mcp": "dist/mcp/server.js"
  },
  "scripts": {
    "map": "node src/cli/main.ts",
    "mcp": "node src/mcp/server.ts",
    "build": "node scripts/build.mjs",
    "check:package": "npm run build && node scripts/check-package-safety.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "smoke:package": "npm run build && node scripts/package-smoke.mjs",
    "release:check": "npm run typecheck && npm test && npm run lint && npm run check:versions && npm run check:package && npm run smoke:package",
    "prepublishOnly": "npm run release:check",
    "prepack": "npm run build",
    "prepare": "node scripts/prepare-package.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "lint": "oxlint src test",
    "bench": "node --expose-gc scripts/benchmark.mjs"
  },
  "engines": {
    "node": ">=23.6"
  },
  "keywords": [
    "code-map",
    "ast",
    "retrieval",
    "llm",
    "symbol-index",
    "mcp",
    "codex",
    "claude",
    "code-navigation",
    "typescript",
    "python"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "oxc-parser": "^0.136.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "oxlint": "1.74.0",
    "typescript": "^7.0.2"
  }
}
